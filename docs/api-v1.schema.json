          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "page_resize"
            },
            "page_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "page_id",
            "width_mm",
            "height_mm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
