{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arranger.local/schema/api-v1",
  "title": "Arranger protocol version 1 request",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {},
    "command": {
      "$ref": "#/$defs/Command"
    }
  },
  "required": [
    "protocol_version",
    "command"
  ],
  "additionalProperties": false,
  "$defs": {
    "Page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "width_mm",
        "height_mm"
      ],
      "additionalProperties": false
    },
    "Style": {
      "type": "object",
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^(none|#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|cmyk\\((?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9])\\)|cmyk255\\((?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\))$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^(none|#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|cmyk\\((?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9]),(?:100|[1-9]?[0-9])\\)|cmyk255\\((?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]),(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\))$"
        },
        "stroke_width_mm": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stroke_linecap": {
          "enum": [
            "butt",
            "round",
            "square"
          ],
          "default": "butt"
        },
        "stroke_linejoin": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ],
          "default": "miter"
        },
        "stroke_miterlimit": {
          "type": "number",
          "minimum": 1,
          "default": 4
        },
        "stroke_scale_with_object": {
          "type": "boolean",
          "default": true,
          "description": "false fixes the circular vector stroke width in page millimetres under object and parent transforms; active text strokes currently require true"
        },
        "stroke_fixed_nib": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedStrokeNib"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fill",
        "stroke",
        "stroke_width_mm",
        "opacity"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "mime",
        "sha256",
        "data_base64"
      ],
      "additionalProperties": false
    },
    "Geometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rect"
            },
            "radius_mm": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "path"
            },
            "d": {
              "type": "string"
            },
            "fill_rule": {
              "$ref": "#/$defs/FillRule",
              "default": "nonzero"
            }
          },
          "required": [
            "kind",
            "d"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "content": {
              "type": "string"
            },
            "font_family": {
              "type": "string",
              "minLength": 1
            },
            "font_size_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "text_path": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextOnPath"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "layout": {
              "$ref": "#/$defs/TextLayoutOptions"
            }
          },
          "required": [
            "kind",
            "content",
            "font_family",
            "font_size_mm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "image"
            },
            "resource_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "clip_mm": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "fit": {
              "enum": [
                "contain",
                "stretch",
                "cover"
              ],
              "default": "contain"
            }
          },
          "required": [
            "kind",
            "resource_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
        },
        "page_id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$",
          "description": "Printable page ID, or reserved _workspace for the document-wide non-printing pasteboard."
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "x_mm": {
          "type": "number"
        },
        "y_mm": {
          "type": "number"
        },
        "width_mm": {
          "type": "number",
          "minimum": 0
        },
        "height_mm": {
          "type": "number",
          "minimum": 0
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "clip": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clip"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "page_id",
        "width_mm",
        "height_mm",
        "geometry"
      ],
      "additionalProperties": false
    },
    "ObjectPatch": {
      "type": "object",
      "properties": {
        "x_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "y_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "width_mm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "height_mm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/Style"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "clip": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clip"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_create"
            },
            "object": {
              "$ref": "#/$defs/Object"
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_update"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "patch": {
              "$ref": "#/$defs/ObjectPatch"
            }
          },
          "required": [
            "type",
            "object_id",
            "patch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_place"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "page_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "required": [
            "type",
            "object_id",
            "page_id"
          ],
          "additionalProperties": false,
          "description": "After geometry edits, assign the root and its descendants to this printable page if source bounds touch it, otherwise to _workspace. Atomic in the same batch."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_duplicate"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "new_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "descendant_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
              },
              "description": "Optional mapping of source descendant IDs to destination IDs. Defaults to new_id.1, new_id.2 in source stacking order."
            }
          },
          "required": [
            "type",
            "object_id",
            "new_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_delete"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "required": [
            "type",
            "object_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object_reparent"
            },
            "object_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "parent_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "object_id",
            "parent_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
