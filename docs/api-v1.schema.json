              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "element": {
              "$ref": "#/$defs/PathElement"
            }
          },
          "required": [
            "type",
            "object_id",
            "index",
            "element"
          ],
